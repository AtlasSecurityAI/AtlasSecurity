              "body": ["Noto Sans", "sans-serif"],
            },
            boxShadow: {
              'soft': '0 20px 40px -10px rgba(0, 50, 100, 0.1)',
              'card': '0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03)',
              'glow': '0 0 20px rgba(43, 140, 238, 0.3)',
